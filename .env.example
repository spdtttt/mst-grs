NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set on the server only; use at least 32 random bytes. Must match account provisioning.
LOGIN_HMAC_SECRET=
# Only used by the local account provisioning script. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push. Generate once with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.mst.ac.th/
